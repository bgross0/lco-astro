# Cloudflare Pages response headers.
# Rules are additive: a request matching several patterns receives every
# matching header, and a header set twice is joined with a comma. Never set
# the same header in overlapping rules.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Fingerprinted build output (build.assets = '_assets'): safe to cache forever.
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files from public/: cache, but let replacements propagate.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/admin/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex
