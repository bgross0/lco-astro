{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Production. Not deployed yet; the custom domain is added at go-live
  // (docs/GO-LIVE.md). Staging is `wrangler deploy --env staging`.
  "name": "lco-astro",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API needs code; every other request is a static asset.
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      // Served at lco-astro-staging.<account>.workers.dev. public/_headers
      // marks every *.workers.dev host noindex.
      "name": "lco-astro-staging"
    }
  }
}
