{
  "name": "lco-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "check:dist": "python3 -I scripts/check-dist.py dist scripts/live-urls.txt",
    "preview": "npm run build && wrangler dev",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy",
    "cms": "BIND_HOST=127.0.0.1 decap-server",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6",
    "phosphor-icons-astro": "^2.1.1-17042025"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "decap-server": "^3.11.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
