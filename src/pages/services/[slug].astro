---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/shadcn-studio/blocks/hero-section-03/hero-section-03';
import ServiceBody from '../../components/site/ServiceBody.astro';
import SocialProof from '../../components/shadcn-studio/blocks/social-proof-03/social-proof-03';
import FAQ from '../../components/shadcn-studio/blocks/faq-component-11/faq-component-11';
import Testimonials from '../../components/shadcn-studio/blocks/testimonials-component-06/testimonials-component-06';
import CTASection from '../../components/shadcn-studio/blocks/cta-section-04/cta-section-04';
import settings from '../../data/settings.json';
import { primaryPhone } from '../../lib/phone';
import { blockImage } from '../../lib/images';
import { categoryPhotos } from '../../lib/blocks';
import { splitSections } from '../../lib/prose';
import { breadcrumbList } from '../../lib/url';
import { getAreas, getReviewSummary, getReviewerInitials, getTestimonials, serviceUrl } from '../../lib/content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { data } = service;
const site = Astro.site!.origin;
const url = new URL(serviceUrl(service), site).href;
const areas = await getAreas();
const summary = await getReviewSummary();
const photos = await categoryPhotos(data.category, data.hero.image);

// The intro copy, then each "## " section in order.
const { intro, sections } = splitSections(service.rendered?.html ?? '');

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: data.title, href: serviceUrl(service) },
];

const jsonLd: Record<string, unknown>[] = [
  breadcrumbList(crumbs, site),
  {
    '@type': 'Service',
    name: data.title,
    serviceType: data.title,
    description: data.summary,
    url,
    provider: { '@id': `${site}/#business` },
    areaServed: areas.map((area) => ({ '@type': 'City', name: area.label })),
  },
];
if (data.faq) {
  jsonLd.push({
    '@type': 'FAQPage',
    mainEntity: data.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}
const stepNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<Layout title={data.seo.title} description={data.seo.description} image={data.hero.image} jsonLd={jsonLd}>
  <HeroSection
    breadcrumbs={crumbs}
    heading={data.hero.heading}
    text={data.hero.text}
    actions={[
      { label: 'Request a Quote', href: '/contact-us', icon: 'arrow' },
      { label: `Call us ${primaryPhone.display}`, href: primaryPhone.href, icon: 'phone' },
    ]}
    rating={{ value: summary.average, count: summary.count, href: settings.google.reviewsUrl, initials: await getReviewerInitials() }}
    image={await blockImage(data.hero.image, data.hero.imageAlt)}
  />

  <ServiceBody
    heading={data.heading}
    summary={data.summary}
    introHtml={intro}
    sections={sections}
    currentHref={serviceUrl(service)}
  />

  {data.process && (
    <SocialProof
      title={data.process.title}
      text={data.process.intro}
      stats={data.process.steps.map((step, index) => ({ value: stepNumber(index), label: step.title, text: step.text }))}
    />
  )}

  {data.faq && <FAQ title={data.faq.title} intro={data.faq.intro} faqItems={data.faq.items} image={photos.faq} />}

  <Testimonials
    title={data.reviews.title}
    text={data.reviews.text}
    testimonials={await getTestimonials()}
    links={{ allReviews: '/reviews', writeReview: settings.google.writeReviewUrl }}
    muted
  />

  <CTASection
    title={data.cta.title}
    text={data.cta.text}
    button={{ label: 'Request a Quote', href: '/contact-us' }}
    phone={primaryPhone}
    image={photos.cta}
  />
</Layout>
