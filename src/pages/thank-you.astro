---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/shadcn-studio/blocks/hero-section-03/hero-section-03';
import SocialProof from '../components/shadcn-studio/blocks/social-proof-03/social-proof-03';
import CTASection from '../components/shadcn-studio/blocks/cta-section-04/cta-section-04';
import { phones } from '../lib/phone';
import { sitePhoto } from '../lib/blocks';

const pageTitle = 'Thank You - Lake County Outdoors';
const pageDescription = "Thank you for contacting Lake County Outdoors. We've received your message and will get back to you soon.";
const [sales, office] = phones;
---

<Layout title={pageTitle} description={pageDescription} noindex>
  <HeroSection
    heading="Thank You!"
    text="We've received your message and will get back to you shortly"
    actions={[
      { label: 'View Our Services', href: '/services', icon: 'arrow' },
      { label: 'Return to Homepage', href: '/' },
    ]}
  />

  <SocialProof
    title="What Happens Next?"
    stats={[
      { value: '01', label: 'Within 24 Hours', text: 'Our team will review your request and reach out to you via phone or email to discuss your needs' },
      { value: '02', label: 'Free Consultation', text: "We'll schedule a consultation to understand your specific requirements and provide expert recommendations" },
      { value: '03', label: 'Custom Quote', text: "You'll receive a detailed, no-obligation quote tailored to your project or service needs" },
    ]}
  />

  <CTASection
    title="Need Immediate Assistance?"
    text="For urgent matters or emergency services, please call us directly"
    button={{ label: `${office?.label ?? sales.label} ${office?.display ?? sales.display}`, href: office?.href ?? sales.href }}
    phone={sales}
    image={await sitePhoto('/images/gallery/photo-07.jpg')}
  />
</Layout>
