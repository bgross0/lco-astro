---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/shadcn-studio/blocks/hero-section-03/hero-section-03';
import AboutUs from '../../components/shadcn-studio/blocks/about-us-page-03/about-us-page-03';
import CTASection from '../../components/shadcn-studio/blocks/cta-section-04/cta-section-04';
import { primaryPhone } from '../../lib/phone';
import { blockImage } from '../../lib/images';
import { sitePhoto } from '../../lib/blocks';
import { prose } from '../../lib/prose';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const home = (await getEntry('homepage', 'home'))!.data;
const date = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const image = data.image ? await blockImage(data.image, data.imageAlt || data.title) : undefined;
---

<Layout title={`${data.title} | Lake County Outdoors Blog`} description={data.description} image={data.image}>
  <HeroSection
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Blog', href: '/blog' },
      { label: data.title, href: `/blog/${post.id}` },
    ]}
    pill={{ badge: date.format(data.pubDate), text: `By ${data.author}` }}
    heading={data.title}
    text={data.description}
    image={image}
  />

  <AboutUs
    contentHtml={post.rendered?.html ?? ''}
    proseClassName={prose}
    media={await sitePhoto('/images/gallery/photo-07.jpg')}
  />

  <CTASection
    title={home.cta.title}
    text={home.cta.text}
    button={{ label: 'Get a Free Quote', href: '/contact-us' }}
    phone={primaryPhone}
    image={await sitePhoto('/images/gallery/photo-01.jpg')}
  />
</Layout>
