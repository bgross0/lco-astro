---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import contactData from '../content/pages/contact.json';
import settings from '../data/settings.json';
import { officePhone, fieldPhone } from '../lib/phone';

const pageTitle = contactData.seo.title;
const pageDescription = contactData.seo.description;

const services = (await getCollection('services'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((service) => service.data.title);

// Set at build time in Cloudflare Pages; without it the form still works,
// protected by the honeypot only (see functions/api/contact.js).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__overlay"></div>
    <div class="container">
      <div class="hero__content">
        <h1 class="hero__title">{contactData.hero.title}</h1>
        <p class="hero__subtitle">
          {contactData.hero.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact">
    <div class="container">
      <div class="contact__grid">
        <div class="contact__form-card">
          <h2 class="contact__form-title">{contactData.form?.title || 'Request a Quote'}</h2>
          {contactData.form?.subtitle && (
            <p class="contact__form-subtitle">{contactData.form.subtitle}</p>
          )}

          <form
            id="quote-form"
            class="form"
            action="/api/contact"
            method="POST"
            data-msg-invalid="Please fill in the required fields and check your email address."
            data-msg-verification="We couldn't confirm you're not a bot. Please try again."
            data-msg-unavailable={`We couldn't send your request just now. Please call us at ${officePhone.display}.`}
          >
            <p class="form__status" role="alert" hidden></p>

            <!-- Honeypot: hidden from people, filled in by bots -->
            <div class="form__hp" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form__row">
              <div class="form__group">
                <label for="firstName" class="form__label">First name</label>
                <input type="text" id="firstName" name="firstName" class="form__input" autocomplete="given-name" maxlength="100" required />
              </div>
              <div class="form__group">
                <label for="lastName" class="form__label">Last name</label>
                <input type="text" id="lastName" name="lastName" class="form__input" autocomplete="family-name" maxlength="100" required />
              </div>
            </div>

            <div class="form__row">
              <div class="form__group">
                <label for="email" class="form__label">Email</label>
                <input type="email" id="email" name="email" class="form__input" autocomplete="email" maxlength="254" required />
              </div>
              <div class="form__group">
                <label for="phone" class="form__label">Phone <span class="form__optional">(optional)</span></label>
                <input type="tel" id="phone" name="phone" class="form__input" autocomplete="tel" maxlength="40" />
              </div>
            </div>

            <div class="form__group">
              <label for="company" class="form__label">Company or property <span class="form__optional">(optional)</span></label>
              <input type="text" id="company" name="company" class="form__input" autocomplete="organization" maxlength="200" />
            </div>

            <div class="form__group">
              <label for="service" class="form__label">Service needed</label>
              <select id="service" name="service" class="form__select" required>
                <option value="">Select a service</option>
                {services.map((title) => <option value={title}>{title}</option>)}
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="form__group">
              <label for="message" class="form__label">Project details</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                class="form__textarea"
                maxlength="5000"
                placeholder="Property location, size, and what you need done"
                required
              ></textarea>
            </div>

            {turnstileSiteKey && (
              <>
                <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
                <noscript>
                  <p class="form__noscript">
                    Our spam check needs JavaScript. If it's turned off, call us at {officePhone.display}.
                  </p>
                </noscript>
              </>
            )}

            <button type="submit" class="form__submit">
              <span class="form__submit-label">{contactData.form?.submitButtonText || 'Send Message'}</span>
              <Icon name="arrow-right" size={20} />
            </button>
          </form>
        </div>

        <div class="contact__info-section">
          <div class="contact__info-card">
            <h2 class="contact__info-title">{contactData.info.title}</h2>
            {contactData.info.description && (
              <p class="contact__info-intro">{contactData.info.description}</p>
            )}
            
            <div class="contact__info-item">
              <div class="contact__info-icon">
                <Icon name="phone" size={24} color="var(--primary)" />
              </div>
              <div class="contact__info-content">
                <h4>Phone</h4>
                <a href={officePhone.href} class="contact__info-link">
                  {settings.cellphone}
                </a>
                <a href={fieldPhone.href} class="contact__info-link">
                  {settings.phone}
                </a>
                <p class="contact__info-note">{settings.hours}</p>
              </div>
            </div>
            
            <div class="contact__info-item">
              <div class="contact__info-icon">
                <Icon name="envelope" size={24} color="var(--primary)" />
              </div>
              <div class="contact__info-content">
                <h4>Email</h4>
                <a href={`mailto:${settings.email}`} class="contact__info-link">
                  {settings.email}
                </a>
                <p class="contact__info-note">{contactData.info.emailResponseTime || "We respond within 24 hours"}</p>
              </div>
            </div>
            
            <div class="contact__info-item">
              <div class="contact__info-icon">
                <Icon name="map-pin" size={24} color="var(--primary)" />
              </div>
              <div class="contact__info-content">
                <h4>Office</h4>
                <p>{settings.address}</p>
              </div>
            </div>
          </div>
          
          <div class="contact__hours-card">
            <h2 class="contact__info-title">Business Hours</h2>
            <div class="contact__hours">
              <div class="contact__hours-row">
                <span>Monday - Friday</span>
                <span>{settings.businessHours?.weekdays || "7:00 AM - 6:00 PM"}</span>
              </div>
              <div class="contact__hours-row">
                <span>Saturday</span>
                <span>{settings.businessHours?.saturday || "8:00 AM - 4:00 PM"}</span>
              </div>
              <div class="contact__hours-row">
                <span>Sunday</span>
                <span>{settings.businessHours?.sunday || "Closed"}</span>
              </div>
            </div>
            <p class="contact__hours-note">
              <strong>Emergency Services:</strong> {contactData.info.emergencyText}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="map">
    <div class="container">
      <div class="map__header">
        <h2 class="map__title">Our Service Area</h2>
        <p class="map__subtitle">
          Proudly serving Hennepin County and surrounding counties throughout the Minneapolis-St. Paul metro area
        </p>
      </div>
      
      <div class="map__container">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d723621.8990398735!2d-93.6319107!3d45.0059978!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x52b2d4e3f3f3f3f3%3A0x3f3f3f3f3f3f3f3f!2sHennepin%20County%2C%20MN!5e0!3m2!1sen!2sus!4v1234567890"
          width="100%"
          height="500"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lake County Outdoors Service Area - Hennepin County and Surrounding Areas"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta">
    <div class="container">
      <div class="cta__content">
        <h2 class="cta__title">Ready to Get Started?</h2>
        <p class="cta__description">
          Contact us today for a free consultation and quote
        </p>
        <div class="cta__actions">
          <Button href={officePhone.href} variant="secondary" size="large">
            <Icon name="phone" size={20} />
            Call {officePhone.display}
          </Button>
        </div>
      </div>
    </div>
  </section>
  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <script>
    // Submit with fetch so a failed send keeps what the visitor typed. Without
    // JavaScript the form posts normally and the server redirects instead.
    const form = document.querySelector<HTMLFormElement>('#quote-form');
    const status = form?.querySelector<HTMLElement>('.form__status');
    const submit = form?.querySelector<HTMLButtonElement>('.form__submit');
    const label = submit?.querySelector<HTMLElement>('.form__submit-label');

    const showError = (code: string) => {
      if (!form || !status) return;
      status.textContent = form.dataset[`msg${code.charAt(0).toUpperCase()}${code.slice(1)}`] ?? form.dataset.msgUnavailable ?? '';
      status.hidden = false;
      status.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    const initialError = new URLSearchParams(location.search).get('error');
    if (initialError) showError(initialError);

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submit || !label || !status) return;
      const idleLabel = label.textContent;
      submit.disabled = true;
      label.textContent = 'Sending…';
      status.hidden = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();
        if (result.ok) {
          location.assign(result.redirect);
          return;
        }
        showError(result.error);
      } catch {
        showError('unavailable');
      }

      // Turnstile tokens are single-use; get a fresh one for the retry.
      (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
      submit.disabled = false;
      label.textContent = idleLabel;
    });
  </script>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    padding: var(--space-16) 0 var(--space-12);
    color: var(--white);
    overflow: hidden;
  }
  
  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  
  .hero__content {
    position: relative;
    text-align: center;
  }
  
  .hero__title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: var(--font-bold);
    margin-bottom: var(--space-4);
  }
  
  .hero__subtitle {
    font-size: var(--text-xl);
    opacity: 0.95;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Contact Section */
  .contact {
    padding: var(--space-20) 0;
    background-color: var(--neutral-light);
  }
  
  .contact__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  /* Form */
  .contact__form-card {
    background: var(--white);
    padding: var(--space-12);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .contact__form-title {
    font-size: var(--text-3xl);
    color: var(--primary);
    margin-bottom: var(--space-3);
  }

  .contact__form-subtitle {
    color: var(--neutral-dark);
    margin-bottom: var(--space-8);
  }

  .form__status {
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    border-radius: var(--radius-md);
    border-left: 4px solid #b42318;
    background: #fef3f2;
    color: #7a271a;
  }

  .form__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .form__group {
    margin-bottom: var(--space-6);
  }

  .form__label {
    display: block;
    font-weight: var(--font-medium);
    color: var(--neutral-dark);
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .form__optional {
    font-weight: normal;
    opacity: 0.8;
  }

  .form__input,
  .form__select,
  .form__textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--neutral-dark);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-family: inherit;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    background-color: var(--white);
  }

  .form__input:focus,
  .form__select:focus,
  .form__textarea:focus {
    outline: 2px solid transparent;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.4);
  }

  .form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form__noscript {
    font-size: var(--text-sm);
    color: var(--neutral-dark);
    margin-top: var(--space-2);
  }

  .form__submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--primary);
    color: var(--white);
    padding: var(--space-4) var(--space-8);
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-base);
    margin-top: var(--space-4);
  }

  .form__submit:hover:not(:disabled) {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .form__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .cf-turnstile {
    margin-top: var(--space-2);
  }

  /* Info Section */
  .contact__info-section {
    display: grid;
    gap: var(--space-6);
  }

  .contact__info-card,
  .contact__hours-card {
    background: var(--white);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .contact__info-intro {
    color: var(--neutral-dark);
    margin-bottom: var(--space-6);
  }
  
  .contact__info-title {
    font-size: var(--text-2xl);
    color: var(--primary);
    margin-bottom: var(--space-6);
  }
  
  .contact__info-item {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  
  .contact__info-item:last-child {
    margin-bottom: 0;
  }
  
  .contact__info-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background-color: rgba(74, 144, 226, 0.1);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
  }
  
  .contact__info-content h4 {
    font-size: var(--text-lg);
    color: var(--neutral-dark);
    margin-bottom: var(--space-1);
  }
  
  .contact__info-link {
    display: block;
    color: var(--primary);
    text-decoration: none;
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    transition: color var(--transition-fast);
  }
  
  .contact__info-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }
  
  .contact__info-note {
    font-size: var(--text-sm);
    color: var(--neutral-dark);
    margin-top: var(--space-1);
  }
  
  .contact__hours {
    margin-bottom: var(--space-6);
  }
  
  .contact__hours-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--neutral-light);
  }
  
  .contact__hours-row:last-child {
    border-bottom: none;
  }
  
  .contact__hours-note {
    padding: var(--space-4);
    background-color: rgba(74, 144, 226, 0.05);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--neutral-dark);
  }

  /* Map Section */
  .map {
    padding: var(--space-20) 0;
    background-color: var(--white);
  }
  
  .map__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  
  .map__title {
    font-size: var(--text-3xl);
    color: var(--primary);
    margin-bottom: var(--space-4);
  }
  
  .map__subtitle {
    font-size: var(--text-lg);
    color: var(--neutral-dark);
    max-width: 600px;
    margin: 0 auto;
  }
  
  .map__container {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    background-color: var(--neutral-light);
  }
  
  .map__container iframe {
    display: block;
    filter: grayscale(20%);
    transition: filter var(--transition-base);
  }
  
  .map__container:hover iframe {
    filter: grayscale(0%);
  }

  /* CTA Section */
  .cta {
    background-color: var(--primary);
    padding: var(--space-16) 0;
  }
  
  .cta__content {
    text-align: center;
    color: var(--white);
  }
  
  .cta__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    margin-bottom: var(--space-4);
  }
  
  .cta__description {
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
    opacity: 0.95;
  }
  
  .cta__actions {
    display: flex;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .contact__form-card {
      padding: var(--space-8);
    }
  }
  
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-12) 0 var(--space-8);
    }
    
    .contact {
      padding: var(--space-12) 0;
    }
    
    .contact__form-card,
    .contact__info-card,
    .contact__hours-card {
      padding: var(--space-6);
    }

    .form__row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .form__submit {
      width: 100%;
      justify-content: center;
    }
    
    .map__container iframe {
      height: 350px;
    }
  }
</style>
