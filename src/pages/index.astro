---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/shadcn-studio/blocks/hero-section-03/hero-section-03';
import Features from '../components/shadcn-studio/blocks/features-section-15/features-section-15';
import SocialProof from '../components/shadcn-studio/blocks/social-proof-03/social-proof-03';
import AboutUs from '../components/shadcn-studio/blocks/about-us-page-03/about-us-page-03';
import Testimonials from '../components/shadcn-studio/blocks/testimonials-component-06/testimonials-component-06';
import CTASection from '../components/shadcn-studio/blocks/cta-section-04/cta-section-04';
import ServiceAreaMap from '../components/site/ServiceAreaMap.astro';
import settings from '../data/settings.json';
import { primaryPhone } from '../lib/phone';
import { blockImage } from '../lib/images';
import { serviceTabs } from '../lib/blocks';
import { getReviewSummary, getReviewerInitials, getTestimonials } from '../lib/content';

const home = (await getEntry('homepage', 'home'))!.data;
const summary = await getReviewSummary();
const testimonials = await getTestimonials();

// Real job and fleet photos for the two scrolling hero columns.
const heroColumns = await Promise.all(
  [
    [
      ['/images/gallery/photo-08.jpg', 'Lake County Outdoors plow trucks lined up in a parking lot'],
      ['/images/gallery/photo-12.jpg', 'Boulder retaining wall and steps along a lawn beside a house'],
      ['/images/gallery/photo-03.jpg', 'Wheel loader stacking a large snow pile'],
      ['/images/services/custom-patios.jpg', 'Flagstone patio with a fire pit beside a modern home'],
      ['/images/gallery/photo-07.jpg', 'Plow truck clearing a parking lot at night'],
    ],
    [
      ['/images/home/crew.jpg', 'The Lake County Outdoors crew in safety vests behind a snow pusher at night'],
      ['/images/gallery/photo-09.jpg', 'Two wheel loaders with snow pushers parked outside a building'],
      ['/images/services/sod-installation.jpg', 'Fresh sod laid across a graded yard beside a house'],
      ['/images/gallery/photo-05.jpg', 'Skid steer with a snow plow attachment on a trailer'],
      ['/images/services/general-landscaping.jpg', 'Paver patio with a retaining wall and new landscaping'],
    ],
  ].map((column) => Promise.all(column.map(([src, alt]) => blockImage(src, alt)))),
);

const highlights = await Promise.all(
  home.highlights.items.map(async (item) => ({
    name: item.title.replace(/^Our\s+/i, ''),
    value: item.title.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    paragraphs: item.paragraphs,
    tags: item.tags,
    media: item.video
      ? { type: 'video' as const, src: item.video, poster: item.image, alt: item.imageAlt }
      : await blockImage(item.image, item.imageAlt),
  })),
);

const stats = [
  ...(home.highlights.items.flatMap((item) => item.stats ?? [])),
  { value: summary.average.toFixed(1), label: 'Rating on Google' },
  { value: String(summary.count), label: 'Google reviews' },
];
---

<Layout title={home.seo.title} description={home.seo.description} image={home.hero.image}>
  <HeroSection
    pill={{ badge: home.shoreline.label ?? 'New', text: home.shoreline.title, href: home.shoreline.link }}
    heading={home.hero.heading}
    text={home.hero.text}
    actions={[
      { label: 'Request a Quote', href: '/contact-us', icon: 'arrow' },
      { label: `Call us ${primaryPhone.display}`, href: primaryPhone.href, icon: 'phone' },
    ]}
    rating={{ value: summary.average, count: summary.count, href: settings.google.reviewsUrl, initials: await getReviewerInitials() }}
    columns={heroColumns}
  />

  <Features
    client:visible
    id="services"
    eyebrow="Our services"
    title={home.services.title}
    text={home.services.text}
    button={{ label: 'View all services', href: '/services' }}
    tabs={await serviceTabs()}
  />

  <SocialProof title={home.stats?.title ?? home.highlights.title} text={home.stats?.text} stats={stats} />

  <AboutUs
    client:visible
    title={home.about.title}
    contentDescription={home.about.text}
    button={{ label: 'More about us', href: '/about-us' }}
    media={await blockImage(home.about.image, home.about.imageAlt)}
    tabs={highlights}
  />

  <Testimonials
    title={home.reviews.title}
    text={home.reviews.text}
    testimonials={testimonials}
    links={{ allReviews: '/reviews', writeReview: settings.google.writeReviewUrl }}
    muted
  />

  <ServiceAreaMap title={home.areas.title} text={home.areas.text} />

  <CTASection
    title={home.cta.title}
    text={home.cta.text}
    button={{ label: home.offer.buttonText, href: home.offer.link }}
    phone={primaryPhone}
    image={await blockImage('/images/gallery/photo-01.jpg', 'Wheel loader with a snow pusher on a trailer in a snowy lot')}
  />
</Layout>
