---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/shadcn-studio/blocks/hero-section-21/hero-section-21';
import Portfolio from '../components/shadcn-studio/blocks/portfolio-16/portfolio-16';
import AboutUs from '../components/shadcn-studio/blocks/about-us-page-02/about-us-page-02';
import Gallery from '../components/shadcn-studio/blocks/gallery-component-09/gallery-component-09';
import Testimonials from '../components/shadcn-studio/blocks/testimonials-component-04/testimonials-component-04';
import CTA from '../components/shadcn-studio/blocks/cta-section-14/cta-section-14';
import ServiceAreaMap from '../components/site/ServiceAreaMap.astro';
import settings from '../data/settings.json';
import { serviceTabs } from '../lib/blocks';
import { getReviewSummary, getTestimonials, getReviews } from '../lib/content';

const home = (await getEntry('homepage', 'home'))!.data;
const gallery = (await getEntry('pages', 'gallery'))!.data as { images: { image: string; alt: string }[] };
const summary = await getReviewSummary();
const testimonials = await getTestimonials();
const reviews = await getReviews();
const tabs = await serviceTabs();
const tabHref = (category: string) => `/services#${tabs.find((tab) => tab.name === category)?.value ?? ''}`;

const avatars = reviews.slice(0, 4).map((review) => ({
  src: '',
  name: review.data.author,
  fallback: review.data.author.replace(/\./g, '').split(/\s+/, 2).map((part) => part[0]).join('').toUpperCase(),
}));

const services = tabs.flatMap((tab) =>
  (tab.cards ?? []).map((card) => ({ title: card.title, description: card.summary, href: card.href, img: card.image.src })),
);

const categories = [
  {
    id: 1,
    title: 'Snow and ice management',
    description: 'Plowing, hauling and salting for retail centers, offices, schools and homes, all season long.',
    link: '/services/commercial-snow-removal',
    imageUrl: '/images/home/fleet-video-poster.jpg',
    imageAlt: 'Plow trucks and skid steers with snow pushers parked in a lot during snowfall',
    backgroundColor: 'bg-sky-600/10 hover:bg-sky-600/20',
    btnColor: 'bg-sky-600 text-white hover:bg-sky-600 focus-visible:ring-sky-600',
  },
  {
    id: 2,
    title: 'Landscaping and hardscapes',
    description: 'Sod, patios, boulder walls, drainage and fencing, designed and built by our own crew.',
    link: tabHref('Landscape Services'),
    imageUrl: '/images/services/custom-patios.jpg',
    imageAlt: 'Flagstone patio with a fire pit beside a modern white home',
    backgroundColor: 'bg-green-600/10 hover:bg-green-600/20',
    btnColor: 'bg-green-600 text-white hover:bg-green-600 focus-visible:ring-green-600',
  },
  {
    id: 3,
    title: 'Excavation and site work',
    description: 'Excavation, grading, land clearing, concrete and dirt hauling with our own loaders and tri-axle trucks.',
    link: tabHref('Excavation & Build'),
    imageUrl: '/images/services/excavation.jpg',
    imageAlt: 'Mini excavator working in a creek bed while a crew member sets rock',
    backgroundColor: 'bg-amber-600/10 hover:bg-amber-600/20',
    btnColor: 'bg-amber-600 text-white hover:bg-amber-600 focus-visible:ring-amber-600',
  },
  {
    id: 4,
    title: 'Shoreline solutions',
    description: 'Aquatic weed removal, shoreline cleanup and riprap installation for lake homes and associations.',
    link: '/shoreline-solutions',
    imageUrl: '/images/gallery/photo-13.jpg',
    imageAlt: 'Rocky riprap shoreline along a pond',
    backgroundColor: 'bg-teal-600/10 hover:bg-teal-600/20',
    btnColor: 'bg-teal-600 text-white hover:bg-teal-600 focus-visible:ring-teal-600',
  },
];
---

<Layout title={home.seo.title} description={home.seo.description} image={home.hero.image}>
  <HeroSection
    client:load
    heading="Snow removal and landscaping for Twin Cities properties"
    text="Our own crew and our own fleet: 10 plow trucks, 14 Bobcats, 6 wheel loaders and 2 tri-axle salters, keeping malls, offices, schools and homes open and safe all winter."
    button={{ label: 'Request a quote', href: '/contact-us' }}
    image={{ src: '/images/home/hero-plow.webp', alt: 'Lake County Outdoors plow truck clearing a parking lot at night', width: 1099, height: 577 }}
    stat={{ value: `${summary.average.toFixed(1)} on Google`, label: `${summary.count} reviews`, href: settings.google.reviewsUrl }}
    cardsTitle="What we do"
    destinations={services}
    avatars={avatars}
  />

  <Portfolio
    client:visible
    badge="Services"
    title="One contractor for every season"
    text="Snow and ice in winter, landscaping and site work the rest of the year, with the same crew and equipment."
    portfolioItems={categories}
  />

  <AboutUs
    client:visible
    aboutUs={{
      title: { before: 'From homes to', highlight: 'Fortune 100', after: 'headquarters' },
      text: 'For more than 10 years we have maintained residential lots, retail centers, schools, public buildings and corporate campuses across the Twin Cities.',
      button: { label: 'About us', href: '/about-us' },
      leftImage: { src: '/images/home/crew.jpg', alt: 'The Lake County Outdoors crew in safety vests behind a snow pusher at night', buttonText: 'Our crew', buttonLink: '/about-us' },
      rightImage: { src: '/images/services/commercial-snow-removal.jpg', alt: 'Aerial view of the Lake County Outdoors fleet lined up in a parking lot', buttonText: 'Our fleet', buttonLink: '/services/commercial-snow-removal' },
      stats: [
        { value: '10+', title: 'Years in business', description: 'Serving the Twin Cities metro' },
        { value: `${summary.average.toFixed(1)} stars`, title: `${summary.count} Google reviews`, description: 'From property managers and homeowners' },
      ],
    }}
  />

  <Gallery
    client:visible
    title="Recent work"
    text="Snow events, hardscapes, excavation and shoreline projects from our crews."
    gallery={gallery.images.map((item) => ({ src: item.image, alt: item.alt }))}
  />

  <Testimonials
    client:visible
    title="What our customers say"
    text={`${summary.average.toFixed(1)} stars from ${summary.count} Google reviews.`}
    testimonials={testimonials}
  />

  <ServiceAreaMap title={home.areas.title} text={home.areas.text} />

  <CTA
    client:visible
    title="Lock in your snow contract before the first storm"
    text="Tell us about your property and we will send a quote for plowing, salting and hauling this season."
    button={{ label: 'Request a quote', href: '/contact-us' }}
    background="/images/home/cta-bg.jpg"
    image={{ src: '/images/home/crew.jpg', alt: 'The Lake County Outdoors crew at night' }}
  />
</Layout>
