---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import ServiceTabs from '../components/sections/ServiceTabs.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import SectionHeader from '../components/sections/SectionHeader.astro';
import ReviewCard from '../components/sections/ReviewCard.astro';
import Img from '../components/common/Img.astro';
import Icon from '../components/common/Icon.astro';
import Button from '../components/common/Button.astro';
import settings from '../data/settings.json';
import { getAreas, projectUrl } from '../lib/content';

const home = (await getEntry('homepage', 'home'))!.data;
const areas = await getAreas();
const projects = await getCollection('projects');
const featured = home.featuredReview ? await getEntry('reviews', home.featuredReview) : undefined;
const areaSlug = (city: string) => city.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<BaseLayout title={home.seo.title} description={home.seo.description} image={home.hero.image}>
  <PageHero
    heading={home.hero.heading}
    text={home.hero.text}
    image={home.hero.image}
    imageAlt={home.hero.imageAlt}
    rating
    align="center"
  />

  <ServiceTabs title={home.services.title} />

  <section class="promo" aria-labelledby="promo-title">
    <div class="container promo__inner">
      <picture class="promo__logo">
        <source srcset="/images/brand/shoreline-logo.webp" type="image/webp" />
        <img src="/images/brand/shoreline-logo.png" alt="Lake County Outdoors Shoreline Solutions logo" width="120" height="120" loading="lazy" decoding="async" />
      </picture>
      <div class="promo__body">
        {home.shoreline.label && <p class="promo__label">{home.shoreline.label}</p>}
        <h2 class="promo__title" id="promo-title">{home.shoreline.title}</h2>
        <p class="promo__text">{home.shoreline.text}</p>
      </div>
      <Button href={home.shoreline.link} variant="secondary" class="promo__button">
        {home.shoreline.linkText}
        <Icon name="arrow-right" size={18} />
      </Button>
    </div>
  </section>

  <section class="about" aria-labelledby="about-title">
    <div class="container about__grid">
      <h2 class="about__title" id="about-title">{home.about.title}</h2>
      <p class="about__text">{home.about.text}</p>
      <div class="about__media">
        <Img src={home.about.image} alt={home.about.imageAlt} sizes="(min-width: 1280px) 1200px, 100vw" />
      </div>
    </div>
  </section>

  <section class="highlights" aria-labelledby="highlights-title">
    <div class="container">
      <SectionHeader title={home.highlights.title} id="highlights-title" />
      <div class="highlights__list">
        {home.highlights.items.map((item, index) => (
          <article class:list={['highlight', { 'highlight--reverse': index % 2 === 1 }]}>
            <div class="highlight__media">
              {item.video ? (
                <video class="highlight__video" controls preload="none" playsinline poster={item.image} aria-label={item.imageAlt}>
                  <source src={item.video} type="video/mp4" />
                </video>
              ) : (
                <Img src={item.image} alt={item.imageAlt} sizes="(min-width: 1024px) 560px, 100vw" />
              )}
            </div>
            <div class="highlight__body">
              <h3 class="highlight__title">{item.title}</h3>
              {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {item.stats && (
                <dl class="highlight__stats">
                  {item.stats.map((stat) => (
                    <div>
                      <dt>{stat.label}</dt>
                      <dd>{stat.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {item.tags && (
                <ul class="highlight__tags" role="list">
                  {item.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ReviewsSection title={home.reviews.title} text={home.reviews.text} />

  <section class="social" aria-labelledby="social-title">
    <div class="container">
      <SectionHeader title={home.social.title} text={home.social.text} id="social-title" />
      <ul class="social__grid" role="list">
        <li>
          <a class="social__card" href={settings.social.instagram} target="_blank" rel="noopener">
            <span class="social__icon social__icon--instagram"><Icon name="instagram" size={30} /></span>
            <span class="social__name">Instagram</span>
            <span class="social__handle">{settings.social.instagramHandle}</span>
            <span class="social__action">Follow us <Icon name="arrow-right" size={16} /></span>
          </a>
        </li>
        <li>
          <a class="social__card" href={settings.social.facebook} target="_blank" rel="noopener">
            <span class="social__icon social__icon--facebook"><Icon name="facebook" size={30} /></span>
            <span class="social__name">Facebook</span>
            <span class="social__handle">{settings.social.facebookName}</span>
            <span class="social__action">Like our page <Icon name="arrow-right" size={16} /></span>
          </a>
        </li>
      </ul>
      {home.social.footnote && <p class="social__footnote">{home.social.footnote}</p>}
    </div>
  </section>

  <section class="offer" aria-labelledby="offer-title">
    <div class="container offer__grid">
      <h2 class="offer__heading" id="offer-title">{home.offer.title}</h2>
      <div class="offer__card">
        <div class="offer__top">
          <h3 class="offer__name">{home.offer.name}</h3>
          <p class="offer__value">{home.offer.value}</p>
        </div>
        <p class="offer__text">{home.offer.text}</p>
        <Button href={home.offer.link} variant="secondary">
          {home.offer.buttonText}
          <Icon name="arrow-right" size={18} />
        </Button>
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="projects" aria-labelledby="projects-title">
      <div class="container">
        <SectionHeader title={home.projects.title} text={home.projects.text} align="left" id="projects-title" />
        <ul class="projects__grid" role="list">
          {projects.map((project) => (
            <li>
              <a class="project-card" href={projectUrl(project)}>
                <div class="project-card__media">
                  <Img src={project.data.image} alt="" sizes="(min-width: 768px) 280px, 100vw" />
                </div>
                <div class="project-card__body">
                  <h3 class="project-card__title">{project.data.title}</h3>
                  {project.data.location && (
                    <p class="project-card__location"><Icon name="map-pin" size={16} /> {project.data.location}</p>
                  )}
                  <p class="project-card__text">{project.data.summary}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="areas" aria-labelledby="areas-title">
    <div class="container areas__grid">
      <div>
        <h2 class="areas__title" id="areas-title">{home.areas.title}</h2>
        <ol class="areas__list">
          {areas.map((area, index) => (
            <li>
              <a href={area.href ?? `/service-areas#${areaSlug(area.city)}`}>
                <span class="areas__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}.</span>
                {area.label}
              </a>
            </li>
          ))}
        </ol>
        <a class="areas__all" href="/service-areas">All service areas <Icon name="arrow-right" size={16} /></a>
      </div>
      {featured && (
        <div class="areas__quote">
          <Icon name="quotes" size={40} class="areas__quote-icon" />
          <ReviewCard review={featured} />
        </div>
      )}
    </div>
  </section>

  <CtaSection title={home.cta.title} text={home.cta.text} />
</BaseLayout>

<style>
  /* Shoreline promo */
  .promo {
    padding: var(--space-12) 0;
    background: linear-gradient(120deg, var(--secondary) 0%, var(--secondary-dark) 100%);
    color: var(--white);
  }

  .promo__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-8);
  }

  .promo__logo img {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-xl);
    background: var(--white);
    padding: var(--space-2);
    box-shadow: var(--shadow-lg);
  }

  .promo__label {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--primary-light);
  }

  .promo__title {
    color: var(--white);
    font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl));
    margin-bottom: var(--space-2);
  }

  .promo__text {
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    max-width: 60ch;
  }

  /* About */
  .about {
    padding: var(--space-20) 0 0;
    background: linear-gradient(180deg, var(--neutral-light) 0%, var(--neutral-light) 70%, var(--white) 70%);
  }

  .about__grid {
    display: grid;
    gap: var(--space-6) var(--space-12);
  }

  .about__title {
    color: var(--secondary);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.05;
    margin: 0;
  }

  .about__text {
    font-size: var(--text-lg);
    line-height: 1.75;
    margin: 0;
  }

  .about__media {
    grid-column: 1 / -1;
    margin-top: var(--space-6);
    overflow: hidden;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
    aspect-ratio: 16 / 7;
  }

  .about__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }

  /* Highlights */
  .highlights {
    padding: var(--space-20) 0;
    background: var(--white);
  }

  .highlights__list {
    display: grid;
    gap: var(--space-16);
  }

  .highlight {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .highlight__media {
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 3;
    background: var(--neutral-light);
  }

  .highlight__media :global(img),
  .highlight__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .highlight__title {
    color: var(--secondary);
    font-size: var(--text-2xl);
  }

  .highlight__body p {
    line-height: 1.75;
  }

  .highlight__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
  }

  .highlight__stats div {
    display: flex;
    flex-direction: column-reverse;
    padding: var(--space-5);
    text-align: center;
    border-radius: var(--radius-lg);
    background: var(--neutral-light);
    border: 1px solid rgba(46, 90, 135, 0.1);
  }

  .highlight__stats dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--neutral-dark);
  }

  .highlight__stats dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--primary-dark);
  }

  .highlight__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
  }

  .highlight__tags li {
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: rgba(74, 144, 226, 0.12);
    color: var(--secondary-dark);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .highlight {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }

    .highlight--reverse .highlight__media {
      order: 2;
    }
  }

  /* Social */
  .social {
    padding: var(--space-20) 0;
    background: var(--neutral-light);
  }

  .social__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-6);
    max-width: 760px;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }

  .social__grid li {
    margin: 0;
  }

  .social__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: var(--shadow-md);
    color: var(--neutral-dark);
    text-align: center;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .social__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    color: var(--neutral-dark);
  }

  .social__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-3);
    border-radius: var(--radius-lg);
    color: var(--white);
  }

  .social__icon--instagram {
    background: linear-gradient(135deg, #f58529, #dd2a7b 50%, #8134af);
  }

  .social__icon--facebook {
    background: #1877f2;
  }

  .social__name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--black);
  }

  .social__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--primary-dark);
  }

  .social__footnote {
    margin: var(--space-8) 0 0;
    text-align: center;
  }

  /* Offer */
  .offer {
    padding: var(--space-20) 0;
    background: var(--white);
  }

  .offer__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .offer__heading {
    color: var(--secondary);
    margin: 0;
  }

  .offer__card {
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--secondary-dark) 100%);
    color: var(--white);
    box-shadow: var(--shadow-xl);
  }

  .offer__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .offer__name {
    color: var(--white);
    font-size: var(--text-2xl);
    margin: 0;
  }

  .offer__value {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
  }

  .offer__text {
    margin: var(--space-4) 0 var(--space-6);
    color: rgba(255, 255, 255, 0.9);
  }

  @media (min-width: 1024px) {
    .offer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }

  /* Projects */
  .projects {
    padding: var(--space-20) 0;
    background: var(--neutral-light);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr));
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .projects__grid li {
    margin: 0;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 220px) 1fr;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-4);
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    color: var(--neutral-dark);
  }

  .project-card:hover {
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    color: var(--neutral-dark);
  }

  .project-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .project-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__title {
    font-size: var(--text-lg);
    color: var(--secondary);
    margin-bottom: var(--space-1);
  }

  .project-card__location {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .project-card__text {
    margin: 0;
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 539px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }

  /* Areas */
  .areas {
    padding: var(--space-20) 0;
    background: var(--white);
  }

  .areas__grid {
    display: grid;
    gap: var(--space-12);
    align-items: start;
  }

  .areas__title {
    color: var(--secondary);
  }

  .areas__list {
    columns: 2;
    column-gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
  }

  .areas__list li {
    break-inside: avoid;
    margin: 0;
  }

  .areas__list a {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--neutral-light);
    color: var(--black);
    font-weight: 500;
  }

  .areas__list a:hover {
    color: var(--primary-dark);
  }

  .areas__number {
    color: var(--primary-dark);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .areas__all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 600;
    color: var(--primary-dark);
  }

  .areas__quote {
    position: relative;
  }

  .areas__quote :global(.areas__quote-icon) {
    color: var(--primary);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 768px) {
    .areas__list {
      columns: 3;
    }
  }

  @media (min-width: 1024px) {
    .areas__grid {
      grid-template-columns: 1.4fr 1fr;
    }

    .areas__list {
      columns: 2;
    }
  }

  @media (max-width: 767px) {
    .promo__inner {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
      gap: var(--space-4);
    }

    .about,
    .highlights,
    .social,
    .offer,
    .projects,
    .areas {
      padding-top: var(--space-16);
      padding-bottom: var(--space-16);
    }

    .about {
      padding-bottom: 0;
    }

    .about__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
