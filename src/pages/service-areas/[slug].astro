---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ServiceTabs from '../../components/sections/ServiceTabs.astro';
import ReviewsSection from '../../components/sections/ReviewsSection.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import Prose from '../../components/common/Prose.astro';
import Icon from '../../components/common/Icon.astro';
import settings from '../../data/settings.json';
import { primaryPhone } from '../../lib/phone';
import { addressText, mapsUrl } from '../../lib/site';
import { areaUrl, getServices, serviceUrl } from '../../lib/content';

export async function getStaticPaths() {
  const areas = await getCollection('serviceAreas');
  return areas.map((area) => ({ params: { slug: area.id }, props: { area } }));
}

const { area } = Astro.props;
const { data } = area;
const { Content } = await render(area);
const place = `${data.city}, ${data.state}`;
const site = Astro.site!.origin;
const services = await getServices();

const jsonLd = [
  {
    '@type': 'Service',
    name: `Landscaping and commercial snow removal in ${place}`,
    url: new URL(areaUrl(area), site).href,
    provider: { '@id': `${site}/#business` },
    areaServed: { '@type': 'City', name: place },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: `Services in ${place}`,
      itemListElement: services.map((service) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: service.data.title, url: new URL(serviceUrl(service), site).href },
      })),
    },
  },
];
---

<BaseLayout title={data.seo.title} description={data.seo.description} image={data.hero.image} jsonLd={jsonLd}>
  <PageHero heading={data.hero.heading} text={data.hero.text} image={data.hero.image} imageAlt={data.hero.imageAlt} size="medium" />

  <section class="area-contact" aria-label={`Contact Lake County Outdoors in ${place}`}>
    <div class="container">
      <ul class="area-contact__grid" role="list">
        <li>
          <a class="area-contact__card" href={primaryPhone.href}>
            <Icon name="phone" size={24} />
            <span class="area-contact__label">Phone number</span>
            <span class="area-contact__value">{primaryPhone.display}</span>
          </a>
        </li>
        <li>
          <a class="area-contact__card" href={`mailto:${settings.email}`}>
            <Icon name="envelope" size={24} />
            <span class="area-contact__label">Email us</span>
            <span class="area-contact__value">{settings.email}</span>
          </a>
        </li>
        <li>
          <a class="area-contact__card" href={mapsUrl} target="_blank" rel="noopener">
            <Icon name="map-pin" size={24} />
            <span class="area-contact__label">Based in</span>
            <span class="area-contact__value">{addressText}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <ServiceTabs title={`Services We Offer in ${place}`} id="area-services" />

  <section class="area-body">
    <div class="container area-body__inner">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Service Areas', href: '/service-areas/' }, { label: place, href: areaUrl(area) }]} />
      <h2 class="area-body__title">{data.heading}</h2>
      <Prose>
        <Content />
      </Prose>
    </div>
  </section>

  <ReviewsSection title={data.reviews.title} text={data.reviews.text} />
  <CtaSection title={data.cta.title} text={data.cta.text} />
</BaseLayout>

<style>
  .area-contact {
    position: relative;
    z-index: 1;
    margin-top: calc(var(--space-12) * -1);
  }

  .area-contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .area-contact__grid li {
    margin: 0;
  }

  .area-contact__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: var(--shadow-xl);
    color: var(--primary-dark);
    text-align: center;
  }

  .area-contact__card:hover {
    text-decoration: none;
    color: var(--secondary);
  }

  .area-contact__label {
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--black);
  }

  .area-contact__value {
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .area-body {
    padding: var(--space-8) 0 var(--space-20);
    background: var(--white);
  }

  .area-body__inner {
    max-width: 860px;
  }

  .area-body__title {
    color: var(--secondary);
    font-size: clamp(var(--text-2xl), 3.5vw, var(--text-4xl));
    margin-bottom: var(--space-6);
  }
</style>
