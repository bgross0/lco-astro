---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/shadcn-studio/blocks/hero-section-03/hero-section-03';
import Features from '../components/shadcn-studio/blocks/features-section-15/features-section-15';
import { blockImage } from '../lib/images';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const date = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const cards = await Promise.all(
  posts.map(async (post) => ({
    title: post.data.title,
    summary: `${date.format(post.data.pubDate)}. ${post.data.description}`,
    href: `/blog/${post.id}`,
    image: await blockImage(post.data.image ?? '/images/gallery/photo-08.jpg', post.data.imageAlt ?? ''),
  })),
);
---

<Layout
  title="Blog | Lake County Outdoors"
  description="Tips, insights, and updates from Lake County Outdoors on landscaping, snow removal, and property maintenance."
>
  <HeroSection heading="Our Blog" text="Tips, insights, and industry updates from Lake County Outdoors" />

  {cards.length === 0 ? (
    <p class="text-muted-foreground px-4 py-16 text-center">No blog posts available yet. Check back soon!</p>
  ) : (
    <Features eyebrow="Blog" title="Latest posts" tabs={[{ name: 'All posts', value: 'all', cards }]} />
  )}
</Layout>
