---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/shadcn-studio/blocks/hero-section-03/hero-section-03';
import AboutUs from '../../components/shadcn-studio/blocks/about-us-page-03/about-us-page-03';
import Gallery from '../../components/shadcn-studio/blocks/gallery-component-05/gallery-component-05';
import CTASection from '../../components/shadcn-studio/blocks/cta-section-04/cta-section-04';
import { primaryPhone } from '../../lib/phone';
import { blockImage } from '../../lib/images';
import { sitePhoto } from '../../lib/blocks';
import { prose } from '../../lib/prose';
import { projectUrl } from '../../lib/content';
import { breadcrumbList } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const home = (await getEntry('homepage', 'home'))!.data;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects' },
  { label: data.title, href: projectUrl(project) },
];
const jsonLd = [breadcrumbList(crumbs, Astro.site!.origin)];
const gallery = await Promise.all((data.gallery ?? []).map((photo) => blockImage(photo.image, photo.alt)));
---

<Layout title={data.seo.title} description={data.seo.description} image={data.image} jsonLd={jsonLd}>
  <HeroSection
    breadcrumbs={crumbs}
    heading={data.title}
    text={data.location}
    actions={[{ label: 'Request a Quote', href: '/contact-us', icon: 'arrow' }]}
    image={await blockImage(data.image, data.imageAlt)}
  />

  <AboutUs
    contentHtml={project.rendered?.html ?? ''}
    proseClassName={prose}
    media={gallery[0] ?? (await blockImage(data.image, data.imageAlt))}
  />

  {gallery.length > 0 && <Gallery eyebrow="Project photos" title={data.title} galleryImage={gallery} />}

  <CTASection
    title={home.cta.title}
    text={home.cta.text}
    button={{ label: 'Request a Quote', href: '/contact-us' }}
    phone={primaryPhone}
    image={await sitePhoto('/images/gallery/photo-01.jpg')}
  />
</Layout>
