---
import Layout from '../layouts/Layout.astro';
import ErrorPage from '../components/shadcn-studio/blocks/error-page-03/error-page-03';
import { sitePhoto } from '../lib/blocks';

const title = '404 - Page Not Found | Lake County Outdoors';
const description = 'The page you are looking for could not be found. Return to our homepage or contact us for assistance.';
---

<Layout title={title} description={description} noindex>
  <ErrorPage
    image={await sitePhoto('/images/gallery/photo-07.jpg')}
    title="Page Not Found"
    text="Sorry, the page you're looking for doesn't exist. It may have been moved or deleted."
    links={[
      { label: 'Commercial Snow Removal', href: '/services/commercial-snow-removal' },
      { label: 'General Landscaping', href: '/services/general-landscaping' },
      { label: 'All Services', href: '/services' },
      { label: 'Service Areas', href: '/service-areas' },
    ]}
  />
</Layout>
