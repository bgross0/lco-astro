---
// Thin bar above the header, as on the current site: hours, the Google
// rating and social links. Hidden on phones, where the header comes first.
import { ClockIcon, StarIcon } from 'lucide-react';
import { FacebookIcon, InstagramIcon } from '@/components/shadcn-studio/brand-icons';
import settings from '../../data/settings.json';
import { hours } from '../../lib/site';

interface Props {
  rating: { average: number; count: number };
}

const { rating } = Astro.props;
// "Monday - Friday" -> "Mon - Fri"
const short = (label: string) => label.replace(/\b([A-Za-z]{3})[a-z]*/g, '$1');
---

<div class="bg-primary text-primary-foreground hidden text-sm md:block">
  <div class="mx-auto flex h-10 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6">
      <p class="flex items-center gap-2">
        <ClockIcon className="size-4 shrink-0" aria-hidden="true" />
        <span>{hours.map((row) => `${short(row.label)}: ${row.text}`).join(' · ')}</span>
      </p>
      <a href={settings.google.reviewsUrl} target="_blank" rel="noopener" class="hidden items-center gap-2 hover:underline lg:flex">
        <span class="flex text-amber-400" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <StarIcon className="size-4 fill-current" />)}
        </span>
        <span>{rating.average.toFixed(1)} stars on Google ({rating.count} reviews)</span>
      </a>
    </div>
    <div class="flex items-center gap-4">
      {
        settings.social.instagram && (
          <a href={settings.social.instagram} target="_blank" rel="noopener" class="hover:opacity-80">
            <InstagramIcon className="size-5" />
            <span class="sr-only">Instagram</span>
          </a>
        )
      }
      {
        settings.social.facebook && (
          <a href={settings.social.facebook} target="_blank" rel="noopener" class="hover:opacity-80">
            <FacebookIcon className="size-5" />
            <span class="sr-only">Facebook</span>
          </a>
        )
      }
    </div>
  </div>
</div>
