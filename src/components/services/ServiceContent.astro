---
export interface Props {
  services?: Array<{
    icon: string;
    title: string;
    items: string[];
  }>;
  benefits?: Array<{
    title: string;
    description: string;
  }>;
  ctaTitle?: string;
  ctaDescription?: string;
  ctaButtonText?: string;
  ctaButtonLink?: string;
}

const {
  services = [],
  benefits = [],
  ctaTitle = "Ready to Get Started?",
  ctaDescription = "Contact us today for professional service you can trust.",
  ctaButtonText = "Get Your Free Quote",
  ctaButtonLink = "/contact"
} = Astro.props;

const iconPaths = {
  'clock': 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  'building': 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  'shield': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'default': 'M5 13l4 4L19 7'
};
---

{services.length > 0 && (
  <section class="services-section">
    <h2 class="section-title">Our Services Include</h2>
    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card">
          <div class="service-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[service.icon] || iconPaths.default}></path>
            </svg>
          </div>
          <h3 class="service-title">{service.title}</h3>
          <ul class="service-list">
            {service.items.map((item) => (
              <li>
                <span class="check">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

{benefits.length > 0 && (
  <section class="benefits-section">
    <h2 class="section-title">Why Choose Lake County Outdoors?</h2>
    <div class="benefits-container">
      <div class="benefits-grid">
        {benefits.map((benefit) => (
          <div class="benefit-item">
            <svg class="benefit-check" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <div class="benefit-content">
              <h4 class="benefit-title">{benefit.title}</h4>
              <p class="benefit-description">{benefit.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<div class="cta-section">
  <h2 class="cta-title">{ctaTitle}</h2>
  <p class="cta-description">{ctaDescription}</p>
  <a href={ctaButtonLink} class="cta-button">
    {ctaButtonText}
    <svg class="cta-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
    </svg>
  </a>
</div>

<style>
  /* Services Section */
  .services-section {
    padding: 3rem 0;
    background: linear-gradient(to bottom, #ffffff 0%, #f8f9fa 100%);
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: bold;
    color: var(--secondary);
    margin-bottom: 3rem;
    text-align: center;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .service-card {
    background: var(--white);
    border: 2px solid transparent;
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--primary), #ffffff);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    border-color: var(--primary);
  }

  .service-card:hover::before {
    transform: scaleX(1);
  }

  .service-icon {
    width: 72px;
    height: 72px;
    background: var(--primary);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    box-shadow: 0 8px 16px rgba(74, 144, 226, 0.3);
  }

  .service-icon svg {
    width: 36px;
    height: 36px;
    color: white;
  }

  .service-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--secondary);
    margin-bottom: 1.25rem;
    line-height: 1.3;
  }

  .service-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-list li {
    display: flex;
    align-items: flex-start;
    margin-bottom: 0.75rem;
    color: var(--neutral-dark);
    font-size: 1rem;
    line-height: 1.6;
  }

  .check {
    color: var(--primary);
    margin-right: 0.75rem;
    font-weight: bold;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  /* Benefits Section */
  .benefits-section {
    padding: 3rem 0;
    background: #f8f9fa;
  }

  .benefits-container {
    background: var(--white);
    border-radius: 20px;
    padding: 3rem;
    margin-bottom: 3rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .benefit-item:hover {
    background: #f8f9fa;
    transform: translateX(8px);
  }

  .benefit-check {
    width: 28px;
    height: 28px;
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .benefit-title {
    font-weight: 700;
    color: var(--secondary);
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .benefit-description {
    font-size: 0.95rem;
    color: var(--neutral-dark);
    line-height: 1.5;
  }

  /* CTA Section */
  .cta-section {
    background: linear-gradient(135deg, var(--primary), #e3f2fd);
    border-radius: 16px;
    padding: 3rem;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    margin-top: 3rem;
  }

  .cta-title {
    font-size: 2rem;
    font-weight: bold;
    color: var(--secondary);
    margin-bottom: 1rem;
  }

  .cta-description {
    color: var(--neutral-dark);
    font-size: 1.125rem;
    margin-bottom: 2rem;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    background: white;
    color: var(--primary);
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.2s ease;
  }

  .cta-button:hover {
    transform: scale(1.05);
    background: #f8f9fa;
  }

  .cta-arrow {
    width: 20px;
    height: 20px;
  }

  /* Animations */
  .service-card {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .services-section {
      padding: 2rem 0;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .service-card {
      padding: 2rem;
    }

    .benefits-section {
      padding: 2rem 0;
    }

    .benefits-container {
      padding: 2rem;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .section-title {
      font-size: 1.75rem;
      margin-bottom: 2rem;
    }

    .cta-section {
      padding: 2rem;
    }

    .cta-title {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>