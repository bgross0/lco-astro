---
import Icon from '../common/Icon.astro';
import Button from '../common/Button.astro';

export interface Props {
  services: Array<{
    icon: string;
    title: string;
    items: string[];
  }>;
  title?: string;
  paragraphs?: string[];
  features?: Array<{
    icon: string;
    text: string;
  }>;
  images?: Array<{
    src: string;
    alt: string;
  }>;
  buttonText?: string;
  buttonLink?: string;
}

const {
  services = [],
  title = "Our Commitment to Quality",
  paragraphs = [],
  features = [],
  images = [],
  buttonText = "Get Started Today",
  buttonLink = "/contact"
} = Astro.props;
---

<section class="service-about-section">
  <div class="container">
    <!-- Row 1: Services Card (left) + Image (right) -->
    <div class="two-column-grid">
      <div class="services-card">
        <h2 class="card-title">Our Services Include</h2>
        <ul class="services-list">
          {services.map((service) => (
            <li class="service-item">
              <div class="service-icon">
                <Icon name={service.icon} size={24} />
              </div>
              <div class="service-content">
                <span class="service-title">{service.title}</span>
                {service.items && service.items.length > 0 && (
                  <span class="service-subtitle">{service.items[0]}</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>

      {images.length > 0 && (
        <div class="image-wrapper">
          <img
            src={images[0].src}
            alt={images[0].alt}
            class="about-image about-image--1"
            width="600"
            height="400"
          />
        </div>
      )}
    </div>

    <!-- Row 2: Image (left) + About Content (right) -->
    <div class="two-column-grid">
      {images.length > 1 && (
        <div class="image-wrapper">
          <img
            src={images[1].src}
            alt={images[1].alt}
            class="about-image about-image--2"
            width="600"
            height="400"
          />
        </div>
      )}

      <div class="about-content">
        <h2 class="about-title">{title}</h2>

        {paragraphs.map((paragraph) => (
          <p class="about-text">{paragraph}</p>
        ))}

        {features.length > 0 && (
          <div class="about-features">
            {features.map((feature) => (
              <div class="about-feature">
                <Icon name={feature.icon} size={24} class="about-feature-icon" />
                <span>{feature.text}</span>
              </div>
            ))}
          </div>
        )}

        <div class="about-actions">
          <Button href={buttonLink} variant="primary">
            {buttonText}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .service-about-section {
    padding: 4rem 0;
    background: #f8f9fa;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .two-column-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: stretch;
    margin-bottom: 3rem;
  }

  .two-column-grid:last-child {
    margin-bottom: 0;
  }

  /* Services Card */
  .services-card {
    background: var(--white);
    border-radius: 20px;
    padding: 3rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    border: 2px solid transparent;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .services-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    border-color: var(--primary);
  }

  .card-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--secondary);
    margin-bottom: 2rem;
    text-align: center;
  }

  .services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .service-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .service-item:hover {
    background: #f8f9fa;
    transform: translateX(8px);
  }

  .service-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: var(--primary);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .service-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--secondary);
    line-height: 1.2;
  }

  .service-subtitle {
    font-size: 0.875rem;
    color: var(--neutral-dark);
    opacity: 0.8;
  }

  /* About Content */
  .about-content {
    background: var(--white);
    border-radius: 20px;
    padding: 3rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .about-title {
    color: var(--secondary);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .about-text {
    font-size: var(--text-lg);
    color: var(--neutral-dark);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .about-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0;
  }

  .about-feature {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--font-medium);
    color: var(--neutral-dark);
  }

  .about-feature-icon {
    flex-shrink: 0;
    color: var(--accent);
  }

  .about-actions {
    margin-top: var(--space-8);
  }

  .image-wrapper {
    display: none;
    height: 100%;
  }

  .about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  /* Responsive */
  @media (min-width: 1024px) {
    .two-column-grid {
      grid-template-columns: 1fr 1fr;
    }

    .image-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .services-card,
    .about-content,
    .image-wrapper {
      height: 550px;
    }
  }

  @media (max-width: 768px) {
    .service-about-section {
      padding: 3rem 0;
    }

    .services-card,
    .about-content {
      padding: 2rem;
    }

    .card-title,
    .about-title {
      font-size: 1.5rem;
    }

    .service-title {
      font-size: 1.1rem;
    }

    .service-icon {
      width: 40px;
      height: 40px;
    }
  }
</style>
