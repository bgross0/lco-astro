---
import navigation from '../../data/navigation.json';
import settings from '../../data/settings.json';
import Icon from '../common/Icon.astro';
import { primaryPhone } from '../../lib/phone';
import { getServiceGroups, serviceUrl } from '../../lib/content';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const groups = await getServiceGroups();
const logoWebp = settings.logo.replace(/\.(png|jpe?g)$/i, '.webp');

const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<div class="mobile-menu">
  <button
    type="button"
    class="mobile-menu__toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-nav"
  >
    <span class="mobile-menu__icon"></span>
  </button>

  <div class="mobile-menu__overlay"></div>

  <nav id="mobile-nav" class="mobile-menu__nav" aria-label="Mobile navigation">
    <div class="mobile-menu__header">
      <a href="/" class="mobile-menu__logo">
        <picture>
          <source srcset={logoWebp} type="image/webp" />
          <img src={settings.logo} alt="Lake County Outdoors home" width="52" height="52" decoding="async" />
        </picture>
      </a>
    </div>

    <ul class="mobile-menu__list">
      <li class="mobile-menu__item">
        <a href="/" class:list={['mobile-menu__link', { 'mobile-menu__link--active': currentPath === '/' }]} aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
      </li>
      {navigation.mainMenu.map((item, index) => {
        if (item.servicesMenu || item.dropdown) {
          return (
            <li class="mobile-menu__item mobile-menu__item--dropdown">
              <button
                type="button"
                class="mobile-menu__link mobile-menu__dropdown-trigger"
                aria-expanded="false"
                aria-controls={`mobile-dropdown-${index}`}
              >
                {item.label}
                <Icon name="caret-down" size={16} class="mobile-menu__dropdown-icon" />
              </button>
              <div class="mobile-menu__dropdown" id={`mobile-dropdown-${index}`} hidden>
                {item.servicesMenu ? (
                  <>
                    {groups.map((group) => (
                      <div class="mobile-menu__group">
                        <p class="mobile-menu__group-heading">{group.category}</p>
                        <ul>
                          {group.services.map((service) => (
                            <li>
                              <a
                                href={serviceUrl(service)}
                                class:list={['mobile-menu__dropdown-link', { 'mobile-menu__dropdown-link--active': isActive(serviceUrl(service)) }]}
                                aria-current={currentPath === serviceUrl(service) ? 'page' : undefined}
                              >
                                {service.data.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                    <a href={item.href} class="mobile-menu__dropdown-link mobile-menu__all">All services</a>
                  </>
                ) : (
                  <ul>
                    {item.dropdown!.map((sub) => (
                      <li>
                        <a
                          href={sub.href}
                          class:list={['mobile-menu__dropdown-link', { 'mobile-menu__dropdown-link--active': isActive(sub.href) }]}
                          aria-current={currentPath === sub.href ? 'page' : undefined}
                        >
                          {sub.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        }
        return (
          <li class="mobile-menu__item">
            <a
              href={item.href}
              class:list={['mobile-menu__link', { 'mobile-menu__link--active': isActive(item.href) }]}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mobile-menu__footer">
      <a href="/contact-us/" class="mobile-menu__cta">Get a free estimate</a>
      <a href={primaryPhone.href} class="mobile-menu__phone">
        <Icon name="phone" size={18} />
        {primaryPhone.display}
      </a>
    </div>
  </nav>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu__toggle');
  const nav = document.querySelector<HTMLElement>('.mobile-menu__nav');
  const overlay = document.querySelector<HTMLElement>('.mobile-menu__overlay');

  if (toggle && nav && overlay) {
    let isOpen = false;

    const setOpen = (open: boolean) => {
      isOpen = open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      nav.classList.toggle('mobile-menu__nav--open', open);
      overlay.classList.toggle('mobile-menu__overlay--open', open);
      document.body.classList.toggle('mobile-menu-open', open);
    };

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!isOpen);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) {
        setOpen(false);
        toggle.focus();
      }
    });

    overlay.addEventListener('click', () => setOpen(false));

    const triggers = [...nav.querySelectorAll<HTMLButtonElement>('.mobile-menu__dropdown-trigger')];
    for (const trigger of triggers) {
      trigger.addEventListener('click', () => {
        const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
        const open = trigger.getAttribute('aria-expanded') !== 'true';
        for (const other of triggers) {
          if (other === trigger) continue;
          other.setAttribute('aria-expanded', 'false');
          const otherPanel = document.getElementById(other.getAttribute('aria-controls') ?? '');
          if (otherPanel) otherPanel.hidden = true;
        }
        trigger.setAttribute('aria-expanded', String(open));
        if (panel) panel.hidden = !open;
      });
    }

    for (const link of nav.querySelectorAll('a')) {
      link.addEventListener('click', () => setOpen(false));
    }

    // Leaving the mobile breakpoint with the drawer open must not leave the page scroll-locked.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && isOpen) setOpen(false);
    });
  }
</script>

<style>
  .mobile-menu {
    display: block;
  }

  @media (min-width: 1024px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu__toggle {
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: calc(var(--z-sticky) + 1);
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu__icon,
  .mobile-menu__icon::before,
  .mobile-menu__icon::after {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--neutral-dark);
    transition: transform var(--transition-fast), background-color var(--transition-fast), top var(--transition-fast), bottom var(--transition-fast);
  }

  .mobile-menu__icon {
    position: relative;
  }

  .mobile-menu__icon::before,
  .mobile-menu__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .mobile-menu__icon::before {
    top: -8px;
  }

  .mobile-menu__icon::after {
    bottom: -8px;
  }

  .mobile-menu__toggle[aria-expanded='true'] .mobile-menu__icon {
    background-color: transparent;
  }

  .mobile-menu__toggle[aria-expanded='true'] .mobile-menu__icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .mobile-menu__toggle[aria-expanded='true'] .mobile-menu__icon::after {
    bottom: 0;
    transform: rotate(-45deg);
  }

  .mobile-menu__nav {
    position: fixed;
    top: 0;
    left: 0;
    width: min(320px, 86vw);
    height: 100vh;
    height: 100dvh;
    background-color: var(--white);
    z-index: calc(var(--z-sticky) - 1);
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.1);
    display: none;
    flex-direction: column;
  }

  .mobile-menu__nav--open {
    display: flex;
  }

  .mobile-menu__header {
    padding: var(--space-6) var(--space-4) var(--space-4);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .mobile-menu__logo {
    display: block;
    width: fit-content;
  }

  .mobile-menu__logo img {
    height: 48px;
    width: auto;
  }

  .mobile-menu__list {
    list-style: none;
    padding: var(--space-3) var(--space-3);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu__item {
    margin: 0;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--neutral-dark);
    text-align: left;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .mobile-menu__link:hover {
    background-color: var(--neutral-light);
    color: var(--primary-dark);
    text-decoration: none;
  }

  .mobile-menu__link--active {
    color: var(--primary-dark);
    font-weight: 600;
    background-color: rgba(74, 144, 226, 0.1);
  }

  .mobile-menu__dropdown-trigger :global(.mobile-menu__dropdown-icon) {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .mobile-menu__dropdown-trigger[aria-expanded='true'] :global(.mobile-menu__dropdown-icon) {
    transform: rotate(180deg);
  }

  .mobile-menu__dropdown {
    padding: 0 0 var(--space-2) var(--space-3);
  }

  .mobile-menu__dropdown ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu__dropdown li {
    margin: 0;
  }

  .mobile-menu__group + .mobile-menu__group {
    margin-top: var(--space-2);
  }

  .mobile-menu__group-heading {
    margin: var(--space-2) 0 var(--space-1);
    padding: 0 var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .mobile-menu__dropdown-link {
    display: block;
    padding: 10px var(--space-3);
    font-size: var(--text-sm);
    color: var(--neutral-dark);
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .mobile-menu__dropdown-link:hover {
    background-color: var(--neutral-light);
    color: var(--primary-dark);
    text-decoration: none;
  }

  .mobile-menu__dropdown-link--active {
    color: var(--primary-dark);
    font-weight: 600;
  }

  .mobile-menu__all {
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--primary-dark);
  }

  .mobile-menu__footer {
    padding: var(--space-4);
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-menu__cta {
    display: block;
    width: 100%;
    padding: var(--space-3);
    background-color: var(--primary-dark);
    color: var(--white);
    text-align: center;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .mobile-menu__cta:hover {
    background-color: var(--secondary);
    color: var(--white);
    text-decoration: none;
  }

  .mobile-menu__phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2);
    color: var(--neutral-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-menu__overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: calc(var(--z-sticky) - 2);
    pointer-events: none;
  }

  .mobile-menu__overlay--open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
</style>

<style is:global>
  body.mobile-menu-open {
    overflow: hidden;
  }
</style>
