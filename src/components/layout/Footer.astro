---
import Icon from '../common/Icon.astro';
import settings from '../../data/settings.json';
import navigation from '../../data/navigation.json';
import { phones } from '../../lib/phone';
import { addressLines, hours, mapsUrl } from '../../lib/site';
import { getAreas, getServices, serviceUrl } from '../../lib/content';

const currentYear = new Date().getFullYear();
const services = await getServices();
const areas = await getAreas();
const areaSlug = (city: string) => city.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const footerLogoWebp = settings.footerLogo.replace(/\.(png|jpe?g)$/i, '.webp');
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <p class="footer__name">Lake County Outdoors</p>
        <picture>
          <source srcset={footerLogoWebp} type="image/webp" />
          <img src={settings.footerLogo} alt="" class="footer__logo" width="120" height="124" loading="lazy" decoding="async" />
        </picture>
        <ul class="footer__social" role="list">
          {settings.social.instagram && (
            <li><a href={settings.social.instagram} target="_blank" rel="noopener" aria-label="Lake County Outdoors on Instagram"><Icon name="instagram" size={22} /></a></li>
          )}
          {settings.social.facebook && (
            <li><a href={settings.social.facebook} target="_blank" rel="noopener" aria-label="Lake County Outdoors on Facebook"><Icon name="facebook" size={22} /></a></li>
          )}
        </ul>
        <address class="footer__contact">
          <a href={mapsUrl} target="_blank" rel="noopener" class="footer__contact-row">
            <Icon name="map-pin" size={18} />
            <span>{addressLines[0]}<br />{addressLines[1]}</span>
          </a>
          {phones.map((phone) => (
            <a href={phone.href} class="footer__contact-row">
              <Icon name="phone" size={18} />
              <span>{phone.label} {phone.display}</span>
            </a>
          ))}
          <a href={`mailto:${settings.email}`} class="footer__contact-row">
            <Icon name="envelope" size={18} />
            <span>{settings.email}</span>
          </a>
        </address>
        <dl class="footer__hours">
          {hours.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>{row.text}</dd>
            </div>
          ))}
        </dl>
      </div>

      <nav class="footer__col" aria-labelledby="footer-company">
        <h2 class="footer__heading" id="footer-company">Company</h2>
        <ul class="footer__list" role="list">
          {navigation.footerCompany.map((link) => (
            <li><a href={link.href} class="footer__link">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-labelledby="footer-services">
        <h2 class="footer__heading" id="footer-services">Services</h2>
        <ul class="footer__list" role="list">
          {services.map((service) => (
            <li><a href={serviceUrl(service)} class="footer__link">{service.data.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-labelledby="footer-areas">
        <h2 class="footer__heading" id="footer-areas">Areas Served</h2>
        <ul class="footer__list footer__list--areas" role="list">
          {areas.map((area) => (
            <li><a href={area.href ?? `/service-areas#${areaSlug(area.city)}`} class="footer__link">{area.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {currentYear} {settings.site_title}. All rights reserved.</p>
      <p class="footer__credit">
        Website by <a href="https://axsys.dev" target="_blank" rel="noopener" class="footer__credit-link">Axsys</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(180deg, var(--secondary) 0%, var(--secondary-dark) 100%);
    color: rgba(255, 255, 255, 0.86);
    padding: var(--space-16) 0 var(--space-8);
    margin-top: auto;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.3fr 0.8fr 1fr 1.4fr;
      gap: var(--space-8);
    }
  }

  .footer__name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--white);
    margin-bottom: var(--space-4);
  }

  .footer__logo {
    width: 120px;
    height: auto;
  }

  .footer__social {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0;
  }

  .footer__social li {
    margin: 0;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
    transition: background-color var(--transition-fast);
  }

  .footer__social a:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .footer__contact {
    display: grid;
    gap: var(--space-2);
    font-style: normal;
  }

  .footer__contact-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
  }

  .footer__contact-row :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .footer__contact-row:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .footer__hours {
    display: grid;
    gap: 2px;
    margin: var(--space-4) 0 0;
  }

  .footer__hours div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 300px;
  }

  .footer__hours dt {
    color: rgba(255, 255, 255, 0.7);
  }

  .footer__hours dd {
    margin: 0;
  }

  .footer__heading {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--white);
    margin-bottom: var(--space-4);
  }

  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__list li {
    margin-bottom: var(--space-2);
  }

  .footer__list--areas {
    columns: 2;
    column-gap: var(--space-6);
  }

  .footer__list--areas li {
    break-inside: avoid;
  }

  .footer__link {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: var(--space-6);
  }

  .footer__copyright,
  .footer__credit {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-xs);
  }

  .footer__credit-link {
    color: rgba(255, 255, 255, 0.86);
    font-weight: 600;
  }

  .footer__credit-link:hover {
    color: var(--white);
  }
</style>
