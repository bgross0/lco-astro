---
import Icon from '../common/Icon.astro';
import navigation from '../../data/navigation.json';
import { primaryPhone } from '../../lib/phone';
import { getServiceGroups, serviceUrl } from '../../lib/content';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const groups = await getServiceGroups();

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="nav" aria-label="Main navigation">
  <ul class="nav__list">
    {navigation.mainMenu.map((item, index) => {
      if (item.servicesMenu) {
        return (
          <li class="nav__item nav__item--dropdown nav__item--mega">
            <button
              type="button"
              class:list={['nav__link', 'nav__dropdown-trigger', { 'nav__link--active': isActive(item.href) }]}
              aria-expanded="false"
              aria-controls={`nav-dropdown-${index}`}
            >
              {item.label}
              <Icon name="caret-down" size={14} class="nav__dropdown-icon" />
            </button>
            <div class="nav__dropdown nav__mega" id={`nav-dropdown-${index}`}>
              <div class="nav__mega-groups">
                {groups.map((group) => (
                  <div class="nav__mega-group">
                    <p class="nav__mega-heading">{group.category}</p>
                    <ul>
                      {group.services.map((service) => (
                        <li>
                          <a
                            href={serviceUrl(service)}
                            class:list={['nav__dropdown-link', { 'nav__dropdown-link--active': isActive(serviceUrl(service)) }]}
                            aria-current={currentPath === serviceUrl(service) ? 'page' : undefined}
                          >
                            {service.data.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <a href={item.href} class="nav__mega-all">
                All services <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </li>
        );
      }
      if (item.dropdown) {
        return (
          <li class="nav__item nav__item--dropdown">
            <button
              type="button"
              class:list={['nav__link', 'nav__dropdown-trigger', { 'nav__link--active': item.dropdown.some((sub) => isActive(sub.href)) }]}
              aria-expanded="false"
              aria-controls={`nav-dropdown-${index}`}
            >
              {item.label}
              <Icon name="caret-down" size={14} class="nav__dropdown-icon" />
            </button>
            <ul class="nav__dropdown" id={`nav-dropdown-${index}`}>
              {item.dropdown.map((sub) => (
                <li>
                  <a
                    href={sub.href}
                    class:list={['nav__dropdown-link', { 'nav__dropdown-link--active': isActive(sub.href) }]}
                    aria-current={currentPath === sub.href ? 'page' : undefined}
                  >
                    {sub.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        );
      }
      return (
        <li class="nav__item">
          <a
            href={item.href}
            class:list={['nav__link', { 'nav__link--active': isActive(item.href) }]}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      );
    })}
    <li class="nav__item nav__item--phone">
      <a href={primaryPhone.href} class="nav__phone-btn">
        <Icon name="phone" size={18} />
        <span class="nav__phone-text">{primaryPhone.display}</span>
        <span class="sr-only">Call {primaryPhone.label}</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  .nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav {
      display: block;
    }

    .nav__list {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav__item {
      margin: 0;
    }

    .nav__link {
      display: flex;
      align-items: center;
      gap: 4px;
      padding: var(--space-2) var(--space-3);
      font-family: var(--font-body);
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--neutral-dark);
      text-decoration: none;
      border-radius: var(--radius-md);
      transition: color var(--transition-fast), background-color var(--transition-fast);
      position: relative;
      white-space: nowrap;
    }

    .nav__link:hover {
      color: var(--primary-dark);
      background-color: rgba(74, 144, 226, 0.1);
      text-decoration: none;
    }

    .nav__link--active {
      color: var(--primary-dark);
      font-weight: 600;
    }

    .nav__link--active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: var(--space-3);
      right: var(--space-3);
      height: 3px;
      background-color: var(--primary);
      border-radius: var(--radius-sm);
    }

    /* Dropdowns */
    .nav__item--dropdown {
      position: relative;
    }

    .nav__dropdown-trigger {
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
    }

    .nav__dropdown-trigger :global(.nav__dropdown-icon) {
      transition: transform var(--transition-fast);
    }

    .nav__item--dropdown:hover :global(.nav__dropdown-icon),
    .nav__item--open :global(.nav__dropdown-icon) {
      transform: rotate(180deg);
    }

    .nav__dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 220px;
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-xl);
      border: 1px solid rgba(0, 0, 0, 0.06);
      padding: var(--space-2) 0;
      margin: var(--space-2) 0 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
      list-style: none;
      z-index: 100;
    }

    /* Bridge the gap so the menu stays open while the pointer moves down. */
    .nav__dropdown::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: calc(var(--space-2) * -1);
      height: var(--space-2);
    }

    .nav__item--dropdown:hover .nav__dropdown,
    .nav__item--open .nav__dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav__dropdown li {
      margin: 0;
    }

    .nav__dropdown-link {
      display: block;
      padding: var(--space-2) var(--space-4);
      color: var(--neutral-dark);
      text-decoration: none;
      font-size: var(--text-sm);
      white-space: nowrap;
      transition: background-color var(--transition-fast), color var(--transition-fast);
    }

    .nav__dropdown-link:hover {
      background-color: rgba(74, 144, 226, 0.1);
      color: var(--primary-dark);
      text-decoration: none;
    }

    .nav__dropdown-link--active {
      color: var(--primary-dark);
      font-weight: 600;
    }

    /* Services mega menu */
    .nav__mega {
      width: min(860px, calc(100vw - 2 * var(--space-6)));
      padding: var(--space-6);
    }

    .nav__mega-groups {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .nav__mega-heading {
      margin: 0 0 var(--space-2);
      padding: 0 var(--space-2);
      font-family: var(--font-heading);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--secondary);
    }

    .nav__mega ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav__mega li {
      margin: 0;
    }

    .nav__mega .nav__dropdown-link {
      padding: 6px var(--space-2);
      border-radius: var(--radius-md);
      white-space: normal;
    }

    .nav__mega-all {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      margin-top: var(--space-4);
      padding: var(--space-2);
      font-weight: 600;
      font-size: var(--text-sm);
      color: var(--primary-dark);
    }

    /* Phone button */
    .nav__item--phone {
      margin-left: var(--space-3);
    }

    .nav__phone-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      background-color: var(--primary-dark);
      color: var(--white);
      font-weight: 600;
      text-decoration: none;
      border-radius: var(--radius-full);
      transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
      box-shadow: var(--shadow-sm);
      white-space: nowrap;
    }

    .nav__phone-btn:hover {
      background-color: var(--secondary);
      color: var(--white);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      text-decoration: none;
    }

    .nav__phone-text {
      font-size: var(--text-sm);
    }
  }

  /* Narrow desktops: keep everything on one line by dropping the number text. */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .nav__link {
      padding: var(--space-2) 10px;
    }

    .nav__phone-text {
      display: none;
    }
  }

  @media (min-width: 1440px) {
    .nav__link {
      font-size: var(--text-base);
      padding: var(--space-2) var(--space-4);
    }
  }
</style>

<script>
  // Disclosure pattern: hover still opens the menu, but keyboard and touch
  // users need an explicit toggle with aria-expanded kept in sync.
  for (const item of document.querySelectorAll<HTMLElement>('.nav__item--dropdown')) {
    const trigger = item.querySelector<HTMLButtonElement>('.nav__dropdown-trigger');
    if (!trigger) continue;

    const setOpen = (open: boolean) => {
      item.classList.toggle('nav__item--open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };

    trigger.addEventListener('click', () => setOpen(trigger.getAttribute('aria-expanded') !== 'true'));

    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        trigger.focus();
      }
    });

    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!item.contains(event.target as Node)) setOpen(false);
    });
  }
</script>
