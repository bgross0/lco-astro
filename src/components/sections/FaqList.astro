---
import SectionHeader from './SectionHeader.astro';

interface Props {
  title: string;
  intro?: string;
  items: { question: string; answer: string }[];
}

const { title, intro, items } = Astro.props;
---

<section class="faq">
  <div class="container faq__inner">
    <SectionHeader title={title} text={intro} eyebrow="FAQs" align="left" />
    <div class="faq__list">
      {items.map((item, index) => (
        <details class="faq__item" open={index === 0}>
          <summary class="faq__question">
            <span class="faq__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="faq__question-text">{item.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: var(--space-20) 0;
    background: var(--neutral-light);
  }

  .faq__inner {
    display: grid;
    gap: var(--space-8);
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
  }

  .faq__item {
    background: var(--white);
    border: 1px solid rgba(46, 90, 135, 0.12);
    border-radius: var(--radius-lg);
  }

  .faq__question {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--secondary-dark);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__number {
    color: var(--primary);
    font-size: var(--text-sm);
  }

  .faq__question-text {
    flex: 1;
  }

  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
    background: var(--secondary);
    transition: transform var(--transition-fast);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__answer {
    margin: 0;
    padding: 0 var(--space-6) var(--space-6) calc(var(--space-6) + var(--space-4) + 1.4em);
    color: var(--neutral-dark);
    line-height: 1.7;
  }

  @media (min-width: 1024px) {
    .faq__inner {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--space-16);
      align-items: start;
    }

    .faq__inner :global(.section-header) {
      position: sticky;
      top: 120px;
    }
  }

  @media (max-width: 767px) {
    .faq {
      padding: var(--space-16) 0;
    }

    .faq__question {
      padding: var(--space-4);
    }

    .faq__answer {
      padding: 0 var(--space-4) var(--space-5);
    }
  }
</style>
