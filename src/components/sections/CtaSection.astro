---
import CallButtons from '../common/CallButtons.astro';

interface Props {
  title: string;
  text?: string;
}

const { title, text } = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="container cta-band__inner">
    <h2 class="cta-band__title" id="cta-band-title">{title}</h2>
    {text && <p class="cta-band__text">{text}</p>}
    <div class="cta-band__actions">
      <CallButtons />
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    background:
      radial-gradient(120% 140% at 15% 0%, rgba(107, 163, 233, 0.35) 0%, transparent 55%),
      linear-gradient(160deg, var(--secondary) 0%, var(--secondary-dark) 100%);
    color: var(--white);
    text-align: center;
    padding: var(--space-20) 0;
  }

  .cta-band__inner {
    max-width: 820px;
  }

  .cta-band__title {
    color: var(--white);
    font-size: clamp(var(--text-3xl), 4.5vw, 3.25rem);
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .cta-band__text {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.88);
    max-width: 52ch;
    margin: 0 auto;
  }

  .cta-band__actions {
    margin-top: var(--space-8);
  }

  .cta-band__actions :global(.call-buttons) {
    justify-content: center;
  }

  @media (max-width: 767px) {
    .cta-band {
      padding: var(--space-16) 0;
    }
  }
</style>
