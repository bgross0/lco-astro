---
import type { Review } from '../../lib/content';
import Stars from '../common/Stars.astro';

interface Props {
  review: Review;
  clamp?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { review, clamp = false } = Astro.props;
const { author, rating, source, date, text } = review.data;
const initial = author.trim().charAt(0).toUpperCase();
---

<figure class:list={['review-card', { 'review-card--clamp': clamp }]} id={`review-${review.id}`}>
  <div class="review-card__top">
    <Stars rating={rating} size={16} />
    <span class="review-card__source">{source}</span>
  </div>
  <blockquote class="review-card__text">
    <p>{text}</p>
  </blockquote>
  <figcaption class="review-card__author">
    <span class="review-card__avatar" aria-hidden="true">{initial}</span>
    <span>
      <span class="review-card__name">{author}</span>
      {date && (
        <time class="review-card__date" datetime={date.toISOString().slice(0, 10)}>
          {date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}
        </time>
      )}
    </span>
  </figcaption>
</figure>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    margin: 0;
    padding: var(--space-6);
    background: var(--white);
    border: 1px solid rgba(46, 90, 135, 0.12);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .review-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .review-card__source {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--neutral-dark);
  }

  .review-card__text {
    flex: 1;
    margin: 0;
    color: var(--black);
    line-height: 1.65;
  }

  .review-card__text p {
    margin: 0;
  }

  .review-card__text p::before {
    content: '\201C';
  }

  .review-card__text p::after {
    content: '\201D';
  }

  .review-card--clamp .review-card__text p {
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .review-card__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--neutral-light);
  }

  .review-card__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: rgba(74, 144, 226, 0.14);
    color: var(--secondary);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .review-card__name {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--secondary-dark);
  }

  .review-card__date {
    display: block;
    font-size: var(--text-xs);
    color: var(--neutral-dark);
  }
</style>
