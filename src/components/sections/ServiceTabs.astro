---
import { getServiceGroups } from '../../lib/content';
import ServiceCard from './ServiceCard.astro';

interface Props {
  title: string;
  text?: string;
  id?: string;
}

// Tabs are progressive enhancement: without JavaScript every group is shown.
const { title, text, id = 'services' } = Astro.props;
const groups = await getServiceGroups();
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section class="service-tabs" id={id} data-service-tabs>
  <div class="container">
    <div class="service-tabs__head">
      <h2 class="service-tabs__title">{title}</h2>
      {text && <p class="service-tabs__text">{text}</p>}
    </div>
    <div class="service-tabs__list" role="tablist" aria-label="Service categories" hidden data-tablist>
      {groups.map((group, index) => (
        <button
          type="button"
          role="tab"
          class="service-tabs__tab"
          id={`${id}-tab-${slug(group.category)}`}
          aria-controls={`${id}-panel-${slug(group.category)}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          {group.category}
          <span class="service-tabs__count">{group.services.length}</span>
        </button>
      ))}
    </div>
    {groups.map((group) => (
      <div
        class="service-tabs__panel"
        id={`${id}-panel-${slug(group.category)}`}
        role="tabpanel"
        aria-labelledby={`${id}-tab-${slug(group.category)}`}
        data-panel
      >
        <h3 class="service-tabs__group" data-group-heading>{group.category}</h3>
        <ul class="service-tabs__grid" role="list">
          {group.services.map((service) => (
            <li><ServiceCard service={service} /></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .service-tabs {
    padding: var(--space-20) 0;
    background: var(--white);
  }

  .service-tabs__head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .service-tabs__title {
    color: var(--secondary);
    margin-bottom: var(--space-3);
  }

  .service-tabs__text {
    font-size: var(--text-lg);
    margin: 0;
  }

  .service-tabs__list {
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-1);
    border-radius: var(--radius-xl);
    background: var(--neutral-light);
    width: fit-content;
    max-width: 100%;
  }

  .service-tabs__list:not([hidden]) {
    display: flex;
  }

  .service-tabs__tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-lg);
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--secondary);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .service-tabs__tab:hover {
    background: rgba(74, 144, 226, 0.12);
  }

  .service-tabs__tab[aria-selected='true'] {
    background: var(--secondary);
    color: var(--white);
  }

  .service-tabs__count {
    min-width: 1.5em;
    padding: 0 6px;
    border-radius: var(--radius-full);
    background: rgba(46, 90, 135, 0.12);
    font-size: var(--text-xs);
    line-height: 1.6;
    text-align: center;
  }

  .service-tabs__tab[aria-selected='true'] .service-tabs__count {
    background: rgba(255, 255, 255, 0.22);
  }

  .service-tabs__panel + .service-tabs__panel {
    margin-top: var(--space-12);
  }

  .service-tabs__group {
    font-size: var(--text-2xl);
    color: var(--secondary-dark);
    margin-bottom: var(--space-6);
  }

  .service-tabs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-tabs__grid li {
    margin: 0;
  }

  /* Enhanced: one panel at a time, headings replaced by the tabs. */
  [data-enhanced] .service-tabs__panel + .service-tabs__panel {
    margin-top: 0;
  }

  [data-enhanced] .service-tabs__group {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .service-tabs {
      padding: var(--space-16) 0;
    }

    .service-tabs__list:not([hidden]) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }

    .service-tabs__tab {
      justify-content: center;
      padding: var(--space-2);
      font-size: var(--text-sm);
      text-align: center;
    }

    .service-tabs__count {
      display: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-service-tabs]')) {
    const tablist = root.querySelector<HTMLElement>('[data-tablist]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    if (!tablist || tabs.length < 2) continue;

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    tablist.hidden = false;
    root.dataset.enhanced = '';
    select(0);

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: index === last ? 0 : index + 1, ArrowLeft: index === 0 ? last : index - 1, Home: 0, End: last }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        select(next, true);
      });
    });
  }
</script>
