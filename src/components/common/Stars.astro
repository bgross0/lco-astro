---
interface Props {
  rating?: number;
  size?: number;
  label?: string;
}

const { rating = 5, size = 18, label = `${rating} out of 5 stars` } = Astro.props;
const stars = Array.from({ length: 5 }, (_, i) => Math.max(0, Math.min(1, rating - i)));
---

<span class="stars" role="img" aria-label={label} style={`--star-size: ${size}px`}>
  {stars.map((fill) => (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={fill >= 0.5 ? 'stars__star stars__star--on' : 'stars__star'}>
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
    </svg>
  ))}
</span>

<style>
  .stars {
    display: inline-flex;
    gap: 2px;
    vertical-align: middle;
  }

  .stars__star {
    width: var(--star-size);
    height: var(--star-size);
    fill: #d6d9dc;
  }

  .stars__star--on {
    fill: #f5b400;
  }
</style>
