---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import settings from '../data/settings.json';
import { primaryPhone } from '../lib/phone';
import { openingHoursSpecification } from '../lib/site';
import { getAreas, getServices, serviceUrl } from '../lib/content';
import { pagePath } from '../lib/url';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  /** Extra schema.org objects for this page (Service, FAQPage, ...). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = settings.site_title,
  description = settings.site_description,
  image = settings.og_image || settings.logo,
  canonical,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const site = Astro.site?.origin ?? 'https://lakecountyoutdoor.com';
const absolute = (path: string) => (path.startsWith('http') ? path : new URL(encodeURI(path), site).href);
const currentUrl = new URL(pagePath(Astro.url), site).href;
const ogImage = absolute(image);

const services = await getServices();
const areas = await getAreas();
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}/#business`,
  name: settings.site_title,
  description: settings.site_description,
  url: `${site}/`,
  logo: absolute(settings.logo),
  image: absolute(settings.og_image),
  telephone: primaryPhone.href.slice(4),
  email: settings.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.address.street,
    addressLocality: settings.address.city,
    addressRegion: settings.address.region,
    postalCode: settings.address.postalCode,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: settings.geo.latitude,
    longitude: settings.geo.longitude,
  },
  openingHoursSpecification,
  sameAs: [settings.social.facebook, settings.social.instagram, settings.social.linkedin].filter(Boolean),
  areaServed: areas.map((area) => ({ '@type': 'City', name: area.label })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Outdoor services',
    itemListElement: services.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.data.title, url: absolute(serviceUrl(service)) },
    })),
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Lake County Outdoors, LLC" />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonical || currentUrl} />}
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={currentUrl} />}
    <meta property="og:site_name" content="Lake County Outdoors, LLC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#2E5A87" />
    
    <!-- Favicon - Multiple sizes for better support -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=3" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    
    <!-- Fonts: preconnect + optimized loading (reduced to 1 family) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap"
      />
    </noscript>
    
    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Google Tag Manager -->
    {settings.analytics?.enableTracking && settings.analytics?.gtmId && (
      <script set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','${settings.analytics.gtmId}');`}></script>
    )}
    <!-- End Google Tag Manager -->

  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {settings.analytics?.enableTracking && settings.analytics?.gtmId && (
      <noscript>
        <iframe 
          src={`https://www.googletagmanager.com/ns.html?id=${settings.analytics.gtmId}`}
          height="0" 
          width="0" 
          style="display:none;visibility:hidden">
        </iframe>
      </noscript>
    )}
    <!-- End Google Tag Manager (noscript) -->
    
    <a href="#main" class="skip-to-content">Skip to content</a>
    
    <Header />
    
    <main id="main" class="main-content">
      <slot />
    </main>
    
    <Footer />
    
    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(business)}></script>
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...data })}></script>
    ))}
  </body>
</html>
